# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# On-premise PostgreSQL on the NCAA server:
# DATABASE_URL=postgresql://ncaa:password@localhost:5432/ncaa_exams
# Leave empty to use SQLite for local development.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Document storage
# ---------------------------------------------------------------------------
# Scanned application letters and receipts. Must be a directory on the NCAA
# server that the application user can write to, kept OUTSIDE any web-served
# path. Documents are only ever served through an authenticated view.
# PRIVATE_MEDIA_ROOT=/var/lib/ncaa-exams/private_media
PRIVATE_MEDIA_ROOT=

# Largest accepted scan, in bytes (default 10 MB).
MAX_UPLOAD_SIZE=10485760

# Optional: hand file serving to nginx instead of streaming through Django.
# Requires an `internal` location in nginx pointing at PRIVATE_MEDIA_ROOT.
# PRIVATE_MEDIA_ACCEL_HEADER=X-Accel-Redirect
# PRIVATE_MEDIA_ACCEL_PREFIX=/protected/

# ---------------------------------------------------------------------------
# OCR (self-hosted; no external cloud services)
# ---------------------------------------------------------------------------
# 'tesseract' in production. 'fake' is a test double and must never be set here.
OCR_ENGINE=tesseract
# Full path to the tesseract binary. Leave empty if it is on PATH.
# Linux:   /usr/bin/tesseract
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_ENGINE_PATH=
OCR_LANGUAGES=eng
# Rasterisation resolution for scanned PDFs. 300 suits printed office documents.
OCR_DPI=300
OCR_MAX_PAGES=20
# Below this percentage a reading is flagged for officer review.
OCR_CONFIDENCE_THRESHOLD=80
OCR_TIMEOUT_SECONDS=300
# A PDF with at least this much embedded text is read directly instead of
# being rasterised and recognised. Low by design: receipts are short documents.
OCR_PDF_TEXT_LAYER_MIN_CHARS=50
# Run OCR in a background thread (recommended). Set to False to process inline.
OCR_BACKGROUND=True

# --- Page preparation ------------------------------------------------------
# Officers photograph documents as often as they scan them, so pages arrive
# sideways, upside down, tilted, and surrounded by the desk they were laid on.
# Each page is cropped to the sheet, turned the right way up, enlarged and
# straightened before it is read.
OCR_AUTO_ROTATE=True
OCR_DESKEW=True
OCR_CROP_TO_PAGE=True
# Long edge of the cheap probe used to compare the four orientations.
OCR_ORIENTATION_PROBE_EDGE=1000
# Turning the page must be a clear improvement, not a coin flip.
OCR_ROTATION_MARGIN=1.15
# A photographed A4 page is often far below the ~300 DPI Tesseract expects.
OCR_MIN_LONG_EDGE=2200
OCR_MAX_UPSCALE=4.0
OCR_MIN_SKEW=0.4
OCR_MAX_SKEW=15.0
# Enlargement used when re-reading a single field, such as the receipt number.
OCR_FIELD_SCALE=6

# ---------------------------------------------------------------------------
# Examinations
# ---------------------------------------------------------------------------
# Prefix for generated examination IDs, e.g. NCAA/PLT/2026/00042
EXAM_NUMBER_PREFIX=NCAA
# NCAA sits Flight Dispatch Paper 1 and Paper 2 on different days, so the
# "both papers share one schedule" box starts unticked. Set to True if the
# operational process changes to a single combined sitting.
FLIGHT_DISPATCH_SHARED_SCHEDULE_DEFAULT=False

# ---------------------------------------------------------------------------
# First administrator (used by `manage.py seed_deployment_admin`)
# ---------------------------------------------------------------------------
DEPLOYMENT_ADMIN_USERNAME=
DEPLOYMENT_ADMIN_PASSWORD=
DEPLOYMENT_ADMIN_EMAIL=admin@ncaa.gov.ng
DEPLOYMENT_ADMIN_FIRST_NAME=System
DEPLOYMENT_ADMIN_LAST_NAME=Administrator
DEPLOYMENT_ADMIN_EMPLOYEE_ID=NCAA-AD-DEPLOY
DEPLOYMENT_ADMIN_PHONE=

# ---------------------------------------------------------------------------
# HTTPS
# ---------------------------------------------------------------------------
# Applies when DEBUG=False. Set to False only if TLS terminates elsewhere and
# the server is reached over plain HTTP inside the NCAA network.
SECURE_SSL_REDIRECT=True

# Set once the server has a trusted certificate (31536000 = one year).
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
